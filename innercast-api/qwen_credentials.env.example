# InnerCast settings. Copy to qwen_credentials.env (setup_linux.sh does this) and fill in. KEEP PRIVATE.

# Qwen / Ollama server (OpenAI-compatible endpoint).
QWEN_BASE_URL=https://your-qwen-server.example.com/v1
# If this Linux machine IS the Qwen/Ollama server, talk to it directly instead (faster, no certificate issues):
# QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=put-the-sk-ollama-key-here
QWEN_MODEL=qwen3.6:35b
# Writing step: {"reasoning_effort":"none"} = fast mode (~8 s per answer, recommended); {} = thinking (~34 s).
QWEN_EXTRA={"reasoning_effort":"none"}

# Key the Bilt app must send as X-API-Key to this API. setup_linux.sh generates one if missing.
INNERCAST_API_KEY=
